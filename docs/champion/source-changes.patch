+@echo off
+setlocal
+pushd "%~dp0" || exit /b 1
+echo ZephyrTrade Champion - optional local Python research server
+echo The first setup downloads Python packages. No trades are submitted.
+if exist ".venv-champion\Scripts\python.exe" goto check_package
+where py >nul 2>nul
