        >>> y_true = [-2, -2, -2]
        >>> y_pred = [-2, -2, -2 + 1e-8]
        >>> r2_score(y_true, y_pred)
        0.0
        >>> r2_score(y_true, y_pred, force_finite=False)
        -inf
